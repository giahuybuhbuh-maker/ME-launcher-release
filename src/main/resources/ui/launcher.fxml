<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="launcher.LauncherController"
           fx:id="rootStackPane"
           styleClass="root-pane layout-classic"
           prefWidth="960" prefHeight="600">

    <!-- Lop 1: Hinh nen (mac dinh hoac tuy chinh) -->
    <Region fx:id="backgroundLayer" styleClass="background-layer"/>

    <!-- Lop 2: Lop phu toi chuyen sac de chu va nut bam luon sac net -->
    <Region fx:id="backgroundOverlay" styleClass="background-overlay"/>

    <!-- Lop 3: Bo cuc giao dien chinh (ho tro chuyen doi Classic / Modern) -->
    <BorderPane fx:id="mainLayoutPane" styleClass="main-layout-pane">

        <left>
            <VBox fx:id="sidebarPane" spacing="6" prefWidth="196" styleClass="sidebar-pane">
                <padding>
                    <Insets top="16" right="10" bottom="16" left="10"/>
                </padding>

                <HBox fx:id="sidebarBrandBox" alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-brand">
                    <ImageView fitHeight="26" fitWidth="26" preserveRatio="true">
                        <image><Image url="@../assets/logo.png"/></image>
                    </ImageView>
                    <Label fx:id="brandTitleLabel" text="ME LAUNCHER" styleClass="logo-label"/>
                </HBox>

                <Region prefHeight="8"/>

                <Button fx:id="navPlayButton" text="Trang chu" maxWidth="Infinity"
                        onAction="#onNavPlayClicked" styleClass="nav-button nav-button-active"/>
                <Button fx:id="navModsButton" text="Mod Loader" maxWidth="Infinity"
                        onAction="#onModLoaderHelpClicked" styleClass="nav-button"/>
                <Button fx:id="navGameDirButton" text="Thu muc game" maxWidth="Infinity"
                        onAction="#onOpenGameDirClicked" styleClass="nav-button"/>
                <Button fx:id="navConsoleButton" text="Console" maxWidth="Infinity"
                        onAction="#onOpenConsoleClicked" styleClass="nav-button"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button fx:id="settingsButton" text="Cai dat" maxWidth="Infinity"
                        onAction="#onSettingsClicked" styleClass="nav-button"/>
            </VBox>
        </left>

        <top>
            <HBox fx:id="topBar" alignment="CENTER_LEFT" spacing="10" styleClass="top-bar">
                <padding>
                    <Insets top="12" right="20" bottom="12" left="20"/>
                </padding>
                <Label fx:id="topBrandLabel" text="ME LAUNCHER" styleClass="top-brand-label" visible="false" managed="false"/>
                <Label text="v0.1.7" styleClass="version-badge"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="account-pill">
                    <ImageView fx:id="skinImageView" fitWidth="26" fitHeight="26" preserveRatio="false" smooth="false"/>
                    <Label fx:id="profileLabel" text="Chua dang nhap" styleClass="profile-label"/>
                    <Button fx:id="loginButton" text="Dang nhap" onAction="#onLoginClicked" styleClass="secondary-button"/>
                </HBox>
            </HBox>
        </top>

        <center>
            <VBox fx:id="centerPane" alignment="CENTER" spacing="14" styleClass="center-pane">
                <padding>
                    <Insets top="20" right="28" bottom="20" left="28"/>
                </padding>
                <ImageView fx:id="heroLogoView" fitHeight="68" preserveRatio="true">
                    <image><Image url="@../assets/logo.png"/></image>
                </ImageView>
                <Label fx:id="welcomeTitleLabel" text="Chao mung tro lai!" styleClass="welcome-label"/>
                <Label fx:id="subtitleLabel" text="San sang phieu luu trong the gioi Minecraft" styleClass="subtitle-label"/>

                <!-- Vi tri dat nut PLAY lon & thanh phien ban khi chon bo cuc Modern -->
                <VBox fx:id="modernLaunchSlot" alignment="CENTER" spacing="12" visible="false" managed="false"
                      styleClass="modern-launch-slot"/>
            </VBox>
        </center>

        <bottom>
            <VBox fx:id="bottomBar" spacing="8" styleClass="bottom-bar">
                <padding>
                    <Insets top="10" right="20" bottom="14" left="20"/>
                </padding>
                <ProgressBar fx:id="downloadProgressBar" prefWidth="Infinity" visible="false"/>
                <HBox fx:id="bottomActionRow" alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="statusLabel" text="San sang" styleClass="status-label"/>
                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Vi tri dat thanh phien ban & nut PLAY khi chon bo cuc Classic -->
                    <HBox fx:id="classicLaunchSlot" alignment="CENTER_RIGHT" spacing="10">
                        <HBox fx:id="versionToolsBox" alignment="CENTER" spacing="8" styleClass="version-tools-box">
                            <CheckBox fx:id="fabricCheckBox" text="Fabric" styleClass="status-label"/>
                            <Button fx:id="modLoaderHelpButton" text="?" onAction="#onModLoaderHelpClicked" styleClass="icon-button"/>
                            <ComboBox fx:id="versionComboBox" prefWidth="175"/>
                            <Button fx:id="refreshVersionsButton" text="" onAction="#onRefreshVersionsClicked" styleClass="icon-button"/>
                        </HBox>
                        <Button fx:id="playButton" text="CHOI" onAction="#onPlayClicked" styleClass="play-button"/>
                    </HBox>
                </HBox>
            </VBox>
        </bottom>

    </BorderPane>
</StackPane>