<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="launcher.SettingsController"
      spacing="12" styleClass="root-pane settings-root"
      prefWidth="680" prefHeight="660">
    <padding>
        <Insets top="18" right="20" bottom="18" left="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Cài đặt (Settings)" styleClass="welcome-label"
               style="-fx-text-fill: #FFFFFF; -fx-font-size: 22px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Giới thiệu" onAction="#onAboutClicked" styleClass="secondary-button"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: transparent; -fx-background-color: rgba(15, 23, 42, 0.88); -fx-background-radius: 0;">
        <content>
            <VBox fx:id="settingsContainer" spacing="14" style="-fx-padding: 16;">

                <!-- 1. Thư mục lưu game -->
                <VBox spacing="6" styleClass="settings-card">
                    <Label text="Thư mục lưu file game (Directory):" styleClass="status-label"/>
                    <HBox spacing="8">
                        <TextField fx:id="gameDirField" promptText="vd: D:\MinecraftData (để trống = thư mục 'game' mặc định)" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="browseGameDirButton" text="Browse..." onAction="#onBrowseGameDirClicked" styleClass="secondary-button"/>
                    </HBox>
                </VBox>

                <!-- 2. Giao diện & Hình nền (MỚI) -->
                <VBox spacing="8" styleClass="settings-card">
                    <Label text="Giao diện &amp; Hình nền (Appearance &amp; Background):" styleClass="section-header-label"/>

                    <Label text="Bố cục giao diện (UI Layout):" styleClass="status-label"/>
                    <HBox spacing="18" alignment="CENTER_LEFT">
                        <RadioButton fx:id="classicLayoutRadio" text="Cổ điển (Sidebar + Thanh đáy)" selected="true"/>
                        <RadioButton fx:id="modernLayoutRadio" text="Tối giản (Thanh icon + Nút Chơi giữa)"/>
                    </HBox>

                    <Label text="Hình nền Launcher (Background):" styleClass="status-label"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="customBackgroundField"
                                   promptText="Mặc định (để trống = dùng hình nền mặc định)"
                                   editable="false" HBox.hgrow="ALWAYS"/>
                        <Button text="Chọn ảnh..." onAction="#onBrowseBackgroundClicked" styleClass="secondary-button"/>
                        <Button text="Mặc định" onAction="#onResetBackgroundClicked" styleClass="secondary-button"/>
                    </HBox>

                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <StackPane fx:id="backgroundPreviewPane" prefWidth="176" prefHeight="104" minWidth="176" minHeight="104"
                                   styleClass="bg-preview-box">
                            <Region fx:id="backgroundPreviewOverlay"/>
                            <Label fx:id="backgroundPreviewLabel" text="Xem trước hình nền" styleClass="status-label"/>
                        </StackPane>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Độ tối lớp phủ nền (Overlay):" styleClass="status-label"/>
                                <Label fx:id="backgroundOverlayValueLabel" text="45%" styleClass="status-label"/>
                            </HBox>
                            <Slider fx:id="backgroundOverlaySlider" min="0" max="80" value="45"
                                    majorTickUnit="20" minorTickCount="1"
                                    showTickMarks="true" showTickLabels="true"/>
                            <CheckBox fx:id="darkThemeCheckBox" text="Giao diện tối (dark theme)"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- 3. Độ phân giải & Fullscreen -->
                <VBox spacing="6" styleClass="settings-card">
                    <Label text="Độ phân giải (Resolution):" styleClass="status-label"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="resWidthField" prefWidth="90" text="925"/>
                        <Label text="X" styleClass="status-label"/>
                        <TextField fx:id="resHeightField" prefWidth="90" text="530"/>
                        <CheckBox fx:id="fullscreenCheckBox" text="Fullscreen (Toàn màn hình)"/>
                    </HBox>
                </VBox>

                <!-- 4. Bộ lọc danh sách phiên bản -->
                <VBox spacing="6" styleClass="settings-card">
                    <Label text="Danh sách phiên bản (Version list):" styleClass="status-label"/>
                    <HBox spacing="18">
                        <CheckBox fx:id="showSnapshotsCheckBox" text="Hiện Snapshots"/>
                        <CheckBox fx:id="showModifiedCheckBox" text="Hiện bản Mod (NeoForge/Forge/OptiFine)" selected="true"/>
                    </HBox>
                    <HBox spacing="18">
                        <CheckBox fx:id="showBetaCheckBox" text="Hiện Beta"/>
                        <CheckBox fx:id="showAlphaCheckBox" text="Hiện Alpha"/>
                        <CheckBox fx:id="showOldReleasesCheckBox" text="Hiện bản cũ (≤ 1.13)" selected="true"/>
                    </HBox>
                </VBox>

                <!-- 5. LỆNH JAVA KHI CHẠY (JAVA & MINECRAFT ARGUMENTS) -->
                <VBox spacing="6" styleClass="settings-card">
                    <Label text="Java Arguments (Lệnh Java khi chạy - JVM Flags):" styleClass="status-label"/>
                    <TextField fx:id="customJvmArgsField"
                               promptText="JVM arguments (vd: -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200)"/>
                    <Label text="Minecraft Arguments (Tham số vào game tùy chỉnh):" styleClass="status-label"/>
                    <TextField fx:id="customGameArgsField"
                               promptText="Minecraft arguments (vd: --server 127.0.0.1)"/>
                </VBox>

                <!-- 6. Đường dẫn Java -->
                <VBox spacing="6" styleClass="settings-card">
                    <Label text="Đường dẫn Java tùy chỉnh (Java path - để trống = tự động tải):" styleClass="status-label"/>
                    <HBox spacing="8">
                        <TextField fx:id="javaPathField" promptText="vd: C:\Program Files\Java\jdk-21\bin\javaw.exe" HBox.hgrow="ALWAYS"/>
                        <Button text="Browse..." onAction="#onBrowseJavaPathClicked" styleClass="secondary-button"/>
                    </HBox>
                </VBox>

                <!-- 7. Phân bổ RAM (Thanh kéo + Ô nhập RAM tối đa & tối thiểu) -->
                <VBox spacing="6" styleClass="settings-card">
                    <Label text="Phân bổ bộ nhớ RAM (Memory allocation - MB):" styleClass="status-label"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Slider fx:id="maxMemorySlider" min="512" max="16384" value="4096"
                                majorTickUnit="4096" minorTickCount="3"
                                showTickMarks="true" showTickLabels="true" HBox.hgrow="ALWAYS"/>
                        <Spinner fx:id="maxMemorySpinner" prefWidth="110" editable="true"/>
                        <Button text="Gợi ý theo máy" onAction="#onSuggestRamClicked" styleClass="secondary-button"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="RAM tối thiểu (MB):" styleClass="status-label"/>
                        <Spinner fx:id="minMemorySpinner" prefWidth="110" editable="true"/>
                    </HBox>
                </VBox>

                <!-- 8. Chế độ đồ họa, Hành vi, RAM Launcher, Ngôn ngữ & Console -->
                <VBox spacing="8" styleClass="settings-card">
                    <Label text="Chế độ chơi (chỉnh đồ họa vanilla trong options.txt):" styleClass="status-label"/>
                    <HBox spacing="16">
                        <RadioButton fx:id="ultrafastRadio" text="Ultrafast"/>
                        <RadioButton fx:id="normalRadio" text="Normal"/>
                        <RadioButton fx:id="highQualityRadio" text="High Quality"/>
                    </HBox>
                    <Label text="Hành vi Launcher khi mở game:" styleClass="status-label"/>
                    <HBox spacing="16">
                        <RadioButton fx:id="hideLauncherRadio" text="Ẩn Launcher khi mở game" selected="true"/>
                        <RadioButton fx:id="keepLauncherOpenRadio" text="Hiện (giữ) Launcher khi mở game"/>
                    </HBox>
                    <Label text="Chế độ RAM Launcher (Low / High):" styleClass="status-label"/>
                    <HBox spacing="16">
                        <RadioButton fx:id="lowRamRadio" text="Low (Ăn ít RAM &lt;150MB)" selected="true"/>
                        <RadioButton fx:id="highRamRadio" text="High (Đủ nền &amp; hiệu ứng 200-400MB)"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Ngôn ngữ (Language):" styleClass="status-label"/>
                        <ComboBox fx:id="languageComboBox" prefWidth="200"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <CheckBox fx:id="showConsoleOnErrorCheckBox" text="Tự hiện Console khi Launcher hoặc game bị lỗi" selected="true"/>
                        <Button text="Mở Console" onAction="#onOpenConsoleClicked" styleClass="secondary-button"/>
                    </HBox>
                </VBox>

                <Label fx:id="infoLabel" styleClass="status-label" wrapText="true"/>
            </VBox>
        </content>
    </ScrollPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Đặt lại mặc định (Reset)" onAction="#onResetDefaultsClicked" styleClass="secondary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Hủy" onAction="#onCancelClicked" styleClass="secondary-button"/>
        <Button text="Lưu (Save)" onAction="#onSaveClicked" styleClass="play-button"/>
    </HBox>
</VBox>